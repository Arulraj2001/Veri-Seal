# ==============================================================================
# VeriSeal Production Environment Configuration Template
# Copy this file to .env.local and populate the secrets for your environment
# ==============================================================================

# 1. Backend Verification Engine (FastAPI on Hugging Face Spaces or Local)
# For production: https://[your-hf-space-name].hf.space
# For local dev: http://127.0.0.1:7860
NEXT_PUBLIC_API_URL=http://127.0.0.1:7860

# 2. NextAuth / Auth.js v5 Security
# Generate with `openssl rand -base64 32` (minimum 32 characters)
AUTH_SECRET=veriseal_production_auth_secret_minimum_32_characters_long
NEXTAUTH_URL=https://veriseal.in

# 3. Super Administrator Access
# Any user authenticating with this email will automatically be granted the 'admin' role
ADMIN_EMAIL=admin@veriseal.in

# 4. Supabase Database & Realtime
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 5. OAuth & Magic Link Email Authentication (Optional)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
EMAIL_SERVER=smtp://user:password@smtp.mailprovider.com:587
EMAIL_FROM=auth@veriseal.in

# 6. Resend Transactional Email Service (Payments, Notifications, Upgrades)
# Sign up at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=VeriSeal <notifications@veriseal.in>

# 7. Telemetry & Analytics
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Google Search Console HTML Verification Token (e.g. google1234567890abcdef)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google-site-verification-code

# 8. Sentry Error & Exception Monitoring
# Sign up at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0
SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your-sentry-cli-auth-token

# 9. Free Daily Verification Limit
NEXT_PUBLIC_VERIFICATION_LIMIT=3
